{
	"hyprland/workspaces": {
		"on-click": "activate",
		"active-only": false,
		"all-outputs": true,
		"format": "{icon}",
		"format-icons": {
			"active": "⏺",
			"default": "•",
			"empty": ".",
			"urgent": "u"
		},
		"persistent-workspaces": {
			"*": 5
		}
	},
	"custom/exit": {
		"format": " ",
		"tooltip-format": "",
		"on-click": "wlogout -b 4",
		"tooltip": false
	},
	"custom/sep": {
		"format": "|",
		"tooltip": false
	},
	"custom/space": {
		"format": " ",
		"tooltip": false
	},
	"tray": {
		"icon-size": 23,
		"spacing": 7
	},
	"clock": {
		"timezone": "Morocco/Casablanca",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": "{:%Y-%m-%d}",
		"tooltip": false
	},
	"cpu": {
		"format": " ",
		"comment-format": " {usage}%",
		"on-click": "$HOME/.config/scripts/focus-btop.sh"
	},
	"memory": {
		"comment-format": " {usage}%",
		"format": " ",
		"on-click": "$HOME/.config/scripts/focus-btop.sh"
	},
	"disk": {
		"interval": 30,
		"comment-format": " {percentage_used}%",
		"format": " ",
		"path": "/",
		"on-click": "$HOME/.config/scripts/focus-btop.sh"
	},
	"group/hardware": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 200,
			"children-class": "not-memory",
			"transition-left-to-right": false
		},
		"modules": [
			"custom/system",
			"hyprland/language",
			"cpu",
			"memory",
			"disk"
		]
	},
	"network": {
		"format": "",
		"format-wifi": "  {signalStrength}",
		"format-ethernet": " ",
		"format-disconnected": true,
		"tooltip-format": "{ifname} via {gwaddri}",
		"tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
		"tooltip-format-ethernet": "  {ifname}\nIP: {ipaddr}\nup: {bandwidthUpBits} down: {bandwidthDownBits}",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50
	},

	"battery": {
		"format": "{icon} {capacity}%",
		"format-charging": "󱐋 {capacity}%",
		"format-icons": [
			"󰂎", "󰁺", "󰁻", "󰁼",
			"󰁽", "󰁾", "󰁿", "󰁿",
			"󰂀", "󰂁", "󰂂", "󰁹"
		]
	},

	"pulseaudio": {
		"scroll-step": 5,
		"max-volume": 100,
		"on-click": "pavucontrol",
		"on-double-click":"",
		"format": "{icon} {volume}",
		"format-muted": "  {volume}",
		"format-bluetooth": " {format_source} {icon} {volume}",
		"format-bluetooth-muted": "check-config {format_source} {icon}",
		"format-source": " ",
		"format-source-muted": " ",
		"format-icons": {
			"headset": " ",
			"headphone": " ",
			"default": [
				" ", " ", " "
			]
		}
	},
	"bluetooth": {
		"format-disabled": "",
		"format-off": "",
		"interval": 30,
		"on-click": "i dont have yet",
		"format-no-controller": ""
	},
	"user": {
		"format": "Yo {user}",
		"interval": 60,
		"icon": false
	},
	"wlr/taskbar": {
        	"format": "{icon}",
        	"icon-size": 20,
        	"tooltip-format": "{title}",
        	"on-click": "activate",
		"on-click-right": "activate",
        	"on-click-middle": "close",
        	"ignore-list": ["kitty"],
		"sort-by-app-id": true,
		"active-first": false
}
	}
}
